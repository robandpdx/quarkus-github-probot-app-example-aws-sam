{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "quarkus:dev",
            "type": "shell",
            "command": "if [ -f .envrc ]; then source .envrc; fi; ./mvnw quarkus:dev",
            "windows": {
                "command": ".\\mvnw.cmd quarkus:dev"
            },
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": "\\b\\B",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeBegins": true,
                        "beginsPattern": "^.*Scanning for projects.*",
                        "endsPattern": "^.*Listening for transport dt_socket at address.*"
                    }
                }
            ]
        },
        {
            "label": "mvn test (debug)",
            "type": "shell",
            "command": "./mvnw test -Dmaven.surefire.debug",
            "windows": {
                "command": ".\\mvnw.cmd test -Dmaven.surefire.debug"
            },
            "group": "test",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": "\\b\\B",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeBegins": true,
                        "beginsPattern": "^.*Scanning for projects.*",
                        "endsPattern": "^.*Listening for transport dt_socket at address.*"
                    }
                }
            ]
        }
    ]
}
